---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

export interface Props {
  hideContactCTA?: boolean;
}
const { hideContactCTA = false } = Astro.props;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <Image src={logo} alt="Prisma Consulting" height={62} />
    </a>
    <nav>
      <a href="/costos">Soluciones en costos</a>
      <a href="/inventarios">Soluciones en inventarios</a>
      <a href="/recursos">Recursos</a>
    </nav>
    {!hideContactCTA && (
      <a href="mailto:mvillalobos356@gmail.com?subject=Consulta%20general" class="btn btn-neutral header-cta">Contactar</a>
    )}
  </div>
</header>
<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    padding: 18px 0;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  nav { display: flex; gap: 22px; flex-wrap: wrap; }
  nav a {
    text-decoration: none;
    font-size: 15px;
    color: var(--text);
  }
  nav a:hover { color: var(--costos); }
  .header-cta { padding: .55rem 1.1rem; font-size: 14px; }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    nav {
      gap: 12px 18px;
      width: 100%;
    }
    .header-cta {
      width: 100%;
      text-align: center;
    }
  }
</style>
