---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand-block">
      <p class="footer-brand">Arakué – Consultoría en Operaciones</p>
      <p class="text-small">Calle Tacna No. 77<br />Santa Cruz de la Sierra, Bolivia</p>
      <p class="text-small">
        Tel. <a href="tel:+59174177475">+591 74177475</a><br />
        <a href="mailto:contacto@arakue.com">contacto@arakue.com</a>
      </p>
    </div>
    <nav aria-label="Secciones">
      <a href="/costos">Costos</a>
      <a href="/inventarios">Inventarios</a>
      <a href="/contacto">Contacto</a>
    </nav>
    <nav aria-label="Redes sociales">
      <a href="https://www.facebook.com/arakue.consultoria" target="_blank" rel="noopener noreferrer">Facebook</a>
      <a href="https://www.instagram.com/arakue.consultoria/" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="https://www.linkedin.com/company/arakue-consultoria" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
    <p class="text-small footer-copy">&copy; {year} Arakué – Consultoría en Operaciones.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 40px 0;
    margin-top: 40px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 28px;
    flex-wrap: wrap;
  }
  .footer-brand { font-weight: 500; margin: 0 0 8px; }
  .footer-brand-block .text-small { margin: 0 0 8px; line-height: 1.6; }
  .footer-brand-block a { color: inherit; }
  .footer-inner nav { display: flex; flex-direction: column; gap: 10px; }
  .footer-inner nav a {
    text-decoration: none;
    font-size: 14px;
    color: var(--text-muted);
  }
  .footer-inner nav a:hover { color: var(--text); }
  .footer-copy { width: 100%; margin: 0; padding-top: 20px; border-top: 1px solid var(--border); }
</style>
